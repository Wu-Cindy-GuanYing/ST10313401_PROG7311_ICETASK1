@model CV_Online_ST10313401.Models.CertificationItem
@{
    ViewData["Title"] = "Add Certification";
}

<div class="container">
    <h1>Add Certification</h1>

    <form method="post" class="form">
        @Html.AntiForgeryToken()

        <label>Name</label>
        <input class="input" asp-for="Name" placeholder="AWS Certified Cloud Practitioner" />
        <span class="help">@Html.ValidationMessageFor(m => m.Name)</span>

        <label>Issuer (optional)</label>
        <input class="input" asp-for="Issuer" placeholder="Amazon Web Services" />

        <label>Year (optional)</label>
        <input class="input" asp-for="Year" placeholder="2025" />

        <label>Credential URL (optional)</label>
        <input class="input" asp-for="Url" placeholder="https://..." />

        <div class="actions">
            <button class="btn btn-primary" type="submit">Create</button>
            <a class="btn" href="/manage/certifications">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}