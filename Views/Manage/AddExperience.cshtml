@model CV_Online_ST10313401.Models.ExperienceItem
@{
    ViewData["Title"] = "Add Experience";
}

<div class="container">
    <h1>Add Experience</h1>

    <form method="post" class="form">
        @Html.AntiForgeryToken()

        <label>Role</label>
        <input class="input" asp-for="Role" placeholder="Software Developer Intern" />
        <span class="help">@Html.ValidationMessageFor(m => m.Role)</span>

        <label>Company</label>
        <input class="input" asp-for="Company" placeholder="Company Name" />
        <span class="help">@Html.ValidationMessageFor(m => m.Company)</span>

        <label>Date Range (optional)</label>
        <input class="input" asp-for="DateRange" placeholder="Jun 2025 – Aug 2025" />

        <label>Bullets (optional, one per line)</label>
        <textarea class="input" asp-for="Bullets" placeholder="- Built X feature&#10;- Improved Y by Z%"></textarea>

        <div class="actions">
            <button class="btn btn-primary" type="submit">Create</button>
            <a class="btn" href="/manage/experience">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}