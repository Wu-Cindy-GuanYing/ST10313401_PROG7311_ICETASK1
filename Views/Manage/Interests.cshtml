@model List<CV_Online_ST10313401.Models.InterestItem>
@{
    ViewData["Title"] = "Interests";
}

<div class="container">
    <div class="actions" style="justify-content:space-between;">
        <h1>Interests</h1>
        <a class="btn btn-primary" href="/manage/addinterest">Add Interest</a>
    </div>

    <table class="table" style="margin-top:12px;">
        <thead>
            <tr>
                <th>Text</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Text</td>
                    <td>
                        <div class="actions">
                            <a class="btn" href="/manage/editinterest/@i.Id">Edit</a>
                            <form method="post" action="/manage/deleteinterest/@i.Id">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Delete this interest?')">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div style="margin-top:12px;">
        <a class="btn" href="/admin">Back</a>
    </div>
</div>