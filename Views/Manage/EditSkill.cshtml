@model OnlineCv.Models.SkillGroup
@{
    ViewData["Title"] = "Edit Skill Group";
}
<div class="container">
    <h1>Edit Skill Group</h1>

    <form method="post" class="form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <label>Title</label>
        <input class="input" asp-for="Title" />
        <span class="help">@Html.ValidationMessageFor(m => m.Title)</span>

        <label>Tags (comma-separated)</label>
        <textarea class="input" asp-for="TagsCsv"></textarea>
        <span class="help">@Html.ValidationMessageFor(m => m.TagsCsv)</span>

        <div class="actions">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn" href="/manage/skills">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}