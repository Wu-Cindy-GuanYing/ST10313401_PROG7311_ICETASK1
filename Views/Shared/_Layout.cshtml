<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - Online CV</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" href="/">Online CV</a>

            <nav class="nav">
                <a href="/">Public CV</a>
                <a href="/cv.pdf">PDF</a>

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <a href="/admin">Admin</a>
                    <form method="post" action="/account/logout" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button class="linkbtn" type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a href="/account/login">Admin Login</a>
                }
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>