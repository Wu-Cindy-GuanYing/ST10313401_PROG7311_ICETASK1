@model OnlineCv.Models.PublicCvViewModel
@{
    ViewData["Title"] = Model.Profile.FullName;
}

<div style="max-width: 900px; margin: 0 auto; padding: 24px; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial;">
    <header style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
        <div style="flex: 1 1 280px;">
            <h1 style="margin:0;">@Model.Profile.FullName</h1>
            <p style="margin:6px 0 0 0; font-size: 1.05rem;">@Model.Profile.ProfessionalTitle</p>
            <p style="margin:10px 0 0 0;">
                <a href="mailto:@Model.Profile.Email">@Model.Profile.Email</a>
                @if (!string.IsNullOrWhiteSpace(Model.Profile.LinkedInUrl))
                {
                    <span> · <a href="@Model.Profile.LinkedInUrl" target="_blank">LinkedIn</a></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Profile.GitHubUrl))
                {
                    <span> · <a href="@Model.Profile.GitHubUrl" target="_blank">GitHub</a></span>
                }
                <span> · <a href="/cv.pdf">Download PDF</a></span>
            </p>
        </div>

        <div style="width:120px; height:120px; border-radius: 16px; overflow:hidden; background:#f2f2f2;">
            @if (!string.IsNullOrWhiteSpace(Model.Profile.PhotoUrl))
            {
                <img src="@Model.Profile.PhotoUrl" alt="Profile photo" style="width:100%; height:100%; object-fit:cover;" />
            }
        </div>
    </header>

    <section style="margin-top: 22px;">
        <h2>About Me</h2>
        <p>@Model.Profile.AboutMe</p>
    </section>

    @if (Model.Skills.Any())
    {
        <section style="margin-top: 22px;">
            <h2>Skills</h2>
            @foreach (var g in Model.Skills)
            {
                <div style="margin-bottom:10px;">
                    <strong>@g.Title:</strong>
                    <span>@g.TagsCsv</span>
                </div>
            }
        </section>
    }

    @if (Model.Projects.Any())
    {
        <section style="margin-top: 22px;">
            <h2>Projects</h2>
            @foreach (var p in Model.Projects)
            {
                <article style="padding:12px 0; border-top: 1px solid #e8e8e8;">
                    <h3 style="margin:0;">@p.Name</h3>
                    <p style="margin:6px 0;">@p.Description</p>
                    <p style="margin:6px 0;"><strong>Tech stack:</strong> @p.TechStack</p>
                    <p style="margin:6px 0;">
                        <a href="@p.GitHubUrl" target="_blank">GitHub Repo</a>
                        @if (!string.IsNullOrWhiteSpace(p.LiveDemoUrl))
                        {
                            <span> · <a href="@p.LiveDemoUrl" target="_blank">Live Demo</a></span>
                        }
                    </p>
                </article>
            }
        </section>
    }

    @if (Model.Education.Any())
    {
        <section style="margin-top: 22px;">
            <h2>Education</h2>
            @foreach (var e in Model.Education)
            {
                <div style="padding:10px 0; border-top: 1px solid #e8e8e8;">
                    <strong>@e.Degree</strong> — @e.Institution
                    @if (!string.IsNullOrWhiteSpace(e.ExpectedGraduation))
                    {
                        <span>(@e.ExpectedGraduation)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(e.Highlights))
                    {
                        <div>@e.Highlights</div>
                    }
                </div>
            }
        </section>
    }

    @if (Model.Experience.Any())
    {
        <section style="margin-top: 22px;">
            <h2>Experience</h2>
            @foreach (var x in Model.Experience)
            {
                <div style="padding:10px 0; border-top: 1px solid #e8e8e8;">
                    <strong>@x.Role</strong> — @x.Company
                    @if (!string.IsNullOrWhiteSpace(x.DateRange))
                    {
                        <span>(@x.DateRange)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(x.Bullets))
                    {
                        <div style="margin-top:6px; white-space:pre-line;">@x.Bullets</div>
                    }
                </div>
            }
        </section>
    }

    <section style="margin-top: 22px;">
        <h2>Contact</h2>
        <p>
            Email: <a href="mailto:@Model.Profile.Email">@Model.Profile.Email</a><br />
            @if (!string.IsNullOrWhiteSpace(Model.Profile.LinkedInUrl))
            {
                <span>LinkedIn: <a href="@Model.Profile.LinkedInUrl" target="_blank">@Model.Profile.LinkedInUrl</a></span>
            }
        </p>
        <small style="color:#666;">(For safety, do not publish your home address, ID/passport number, or date of birth.)</small>
    </section>
</div>