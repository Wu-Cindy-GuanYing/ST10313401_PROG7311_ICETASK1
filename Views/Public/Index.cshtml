@model CV_Online_ST10313401.Models.PublicCvViewModel
@{
    ViewData["Title"] = Model.Profile.FullName;
}

<div class="container">
    <header class="hero">
        <div style="flex:1 1 320px;">
            <h1 style="margin:0;">@Model.Profile.FullName</h1>
            <p style="margin:6px 0 0 0; font-size:1.05rem;">@Model.Profile.ProfessionalTitle</p>

            <p style="margin:10px 0 0 0;">
                <a href="mailto:@Model.Profile.Email">@Model.Profile.Email</a>
                @if (!string.IsNullOrWhiteSpace(Model.Profile.LinkedInUrl))
                {
                    <span> · <a href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Profile.GitHubUrl))
                {
                    <span> · <a href="@Model.Profile.GitHubUrl" target="_blank" rel="noopener">GitHub</a></span>
                }
                <span> · <a href="/cv.pdf">Download PDF</a></span>
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Profile.Region))
            {
                <p class="help" style="margin:6px 0 0 0;">@Model.Profile.Region</p>
            }
        </div>

        <div class="avatar">
            @if (!string.IsNullOrWhiteSpace(Model.Profile.PhotoUrl))
            {
                <img src="@Model.Profile.PhotoUrl" alt="Profile photo" />
            }
        </div>
    </header>

    <section class="section">
        <h2>About Me</h2>
        <p>@Model.Profile.AboutMe</p>
    </section>

    @if (Model.Skills.Any())
    {
        <section class="section">
            <h2>Skills</h2>

            @foreach (var g in Model.Skills)
            {
                <div class="card" style="margin-top:10px;">
                    <strong>@g.Title</strong>
                    <div class="tagrow">
                        @{
                            var tags = (g.TagsCsv ?? "")
                            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                            foreach (var t in tags)
                            {
                                <span class="tag">@t</span>
                            }
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (Model.Projects.Any())
    {
        <section class="section">
            <h2>Projects</h2>

            @foreach (var p in Model.Projects)
            {
                <article class="card" style="margin-top:10px;">
                    <h3 style="margin:0;">@p.Name</h3>
                    <p style="margin:8px 0;">@p.Description</p>
                    <p style="margin:8px 0;"><strong>Tech stack:</strong> @p.TechStack</p>

                    <div class="actions">
                        <a class="btn" href="@p.GitHubUrl" target="_blank" rel="noopener">GitHub Repo</a>
                        @if (!string.IsNullOrWhiteSpace(p.LiveDemoUrl))
                        {
                            <a class="btn" href="@p.LiveDemoUrl" target="_blank" rel="noopener">Live Demo</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.ScreenshotUrl))
                        {
                            <a class="btn" href="@p.ScreenshotUrl" target="_blank" rel="noopener">Screenshot</a>
                        }
                    </div>
                </article>
            }
        </section>
    }

    @if (Model.Experience.Any())
    {
        <section class="section">
            <h2>Experience</h2>

            @foreach (var x in Model.Experience)
            {
                <div class="card" style="margin-top:10px;">
                    <strong>@x.Role</strong> — @x.Company
                    @if (!string.IsNullOrWhiteSpace(x.DateRange))
                    {
                        <span class="help">(@x.DateRange)</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(x.Bullets))
                    {
                        <div style="margin-top:10px; white-space:pre-line;">@x.Bullets</div>
                    }
                </div>
            }
        </section>
    }

    @if (Model.Education.Any())
    {
        <section class="section">
            <h2>Education</h2>

            @foreach (var e in Model.Education)
            {
                <div class="card" style="margin-top:10px;">
                    <strong>@e.Degree</strong> — @e.Institution
                    @if (!string.IsNullOrWhiteSpace(e.ExpectedGraduation))
                    {
                        <span class="help">(@e.ExpectedGraduation)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(e.Highlights))
                    {
                        <div style="margin-top:10px;">@e.Highlights</div>
                    }
                </div>
            }
        </section>
    }

    @if (Model.Certifications.Any())
    {
        <section class="section">
            <h2>Certifications</h2>

            @foreach (var c in Model.Certifications)
            {
                <div class="card" style="margin-top:10px;">
                    <strong>@c.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(c.Issuer) || !string.IsNullOrWhiteSpace(c.Year))
                    {
                        <div class="help">@c.Issuer @(!string.IsNullOrWhiteSpace(c.Year) ? $"({c.Year})" : "")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Url))
                    {
                        <div style="margin-top:8px;"><a href="@c.Url" target="_blank" rel="noopener">Credential link</a></div>
                    }
                </div>
            }
        </section>
    }

    @if (Model.Volunteering.Any())
    {
        <section class="section">
            <h2>Volunteering / Leadership</h2>

            @foreach (var v in Model.Volunteering)
            {
                <div class="card" style="margin-top:10px;">
                    <strong>@v.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(v.Org))
                    {
                        <span class="help">— @v.Org</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(v.Description))
                    {
                        <div style="margin-top:10px;">@v.Description</div>
                    }
                </div>
            }
        </section>
    }

    @if (Model.Interests.Any())
    {
        <section class="section">
            <h2>Interests</h2>
            <div class="card" style="margin-top:10px;">
                @foreach (var i in Model.Interests)
                {
                    <div>@i.Text</div>
                }
            </div>
        </section>
    }

    <section class="section">
        <h2>Contact</h2>
        <div class="card">
            <div>Email: <a href="mailto:@Model.Profile.Email">@Model.Profile.Email</a></div>
            @if (!string.IsNullOrWhiteSpace(Model.Profile.LinkedInUrl))
            {
                <div>LinkedIn: <a href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener">@Model.Profile.LinkedInUrl</a></div>
            }
        </div>

        <div class="help" style="margin-top:10px;">
            Safety reminder: don’t publish your home address, ID/passport number, or date of birth.
        </div>
    </section>
</div>