@model CV_Online_ST10313401.Models.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="stack">
    <section class="card">
        <h1>Admin Login</h1>
        <p>Login to update your CV content.</p>
    </section>

    <section class="card">
        <form method="post" class="form">
            @Html.AntiForgeryToken()

            <label>Email</label>
            <input class="input" asp-for="Email" />
            <div class="help">@Html.ValidationMessageFor(m => m.Email)</div>

            <label>Password</label>
            <input class="input" asp-for="Password" type="password" />
            <div class="help">@Html.ValidationMessageFor(m => m.Password)</div>

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="actions">
                <button class="btn btn-primary" type="submit">Login</button>
                <a class="btn" href="/">Back</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}